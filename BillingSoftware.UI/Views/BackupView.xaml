<UserControl x:Class="BillingSoftware.UI.Views.BackupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BillingSoftware.UI.Views"
             mc:Ignorable="d" 
             d:DesignHeight="550" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <!-- Status Bar Footer -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- MAIN LAYOUT -->
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
            <StackPanel>
                
                <!-- Info Header card -->
                <Border Style="{StaticResource ModernCard}" Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="Database Backup &amp; Recovery Maintenance" Style="{StaticResource Header2}" Margin="0,0,0,8"/>
                        <TextBlock Text="Keep your local textile business data safe. Since the software is completely offline, backups are stored as standard ZIP compression files locally on your machine. You are recommended to store backups on an external drive or a synced folder." 
                                   Style="{StaticResource MutedText}" TextWrapping="Wrap" LineHeight="18"/>
                    </StackPanel>
                </Border>

                <!-- Target Backup Folder Card -->
                <Border Style="{StaticResource ModernCard}" Margin="0,0,0,15">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Backup Output Directory Path" Style="{StaticResource Header2}" Margin="0,0,0,10" />

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            
                            <TextBox Text="{Binding BackupFolderPath, Mode=OneWay}" IsReadOnly="True" Grid.Column="0" Height="36" VerticalContentAlignment="Center"/>
                            <Button Content="Choose Backup Folder..." Command="{Binding SelectBackupPathCommand}" Style="{StaticResource SecondaryButton}" Grid.Column="1" Margin="10,0,0,0" Height="36"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Actions card -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Create Backup Side -->
                    <Border Grid.Column="0" Style="{StaticResource ModernCard}" Margin="0,0,8,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Backup Database" Style="{StaticResource Header2}" Margin="0,0,0,12"/>
                            
                            <TextBlock Grid.Row="1" Text="Generate a timestamped ZIP copy of your sales registry, stock ledger, customers list, and role configurations. Your current work will not be interrupted." 
                                       Style="{StaticResource MutedText}" TextWrapping="Wrap" LineHeight="18" Margin="0,0,0,20"/>

                            <Button Grid.Row="2" Content="Create ZIP Backup Now" Command="{Binding CreateBackupCommand}" Height="40" FontSize="13" FontWeight="Bold"/>
                        </Grid>
                    </Border>

                    <!-- Restore Backup Side -->
                    <Border Grid.Column="1" Style="{StaticResource ModernCard}" Margin="8,0,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Restore Database" Style="{StaticResource Header2}" Foreground="{DynamicResource DangerBrush}" Margin="0,0,0,12"/>
                            
                            <Border Grid.Row="1" Background="#FFF5F5" BorderBrush="#FFD6D6" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,20">
                                <StackPanel>
                                    <TextBlock Text="WARNING: RESTORATION OVERWRITES CURRENT DATA!" Foreground="{DynamicResource DangerBrush}" FontWeight="Bold" FontSize="11" Margin="0,0,0,5"/>
                                    <TextBlock Text="Restoring a previous backup overwrites the active billing ledger database. Active sessions will be terminated and you must restart the app." 
                                               FontSize="11" Foreground="#8A2525" TextWrapping="Wrap" LineHeight="15"/>
                                </StackPanel>
                            </Border>

                            <Button Grid.Row="2" Content="Select ZIP &amp; Restore" Command="{Binding RestoreBackupCommand}" Style="{StaticResource DangerButton}" Height="40" FontSize="13" FontWeight="Bold"/>
                        </Grid>
                    </Border>
                </Grid>

            </StackPanel>
        </ScrollViewer>

        <!-- STATUS BAR FOOTER -->
        <Border Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource SurfaceBrush}" Padding="15,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" Style="{StaticResource MutedText}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <ProgressBar Grid.Column="1" Width="100" Height="8" IsIndeterminate="True" VerticalAlignment="Center" 
                             Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
