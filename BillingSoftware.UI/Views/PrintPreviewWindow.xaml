<Window x:Class="BillingSoftware.UI.Views.PrintPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BillingSoftware.UI.Views"
        mc:Ignorable="d"
        Title="Invoice Print Preview" Height="700" Width="850"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}"
        FontFamily="{StaticResource MainFont}">
    <Grid>
        <Grid.RowDefinitions>
            <!-- Preview Controls Bar -->
            <RowDefinition Height="50" />
            <!-- PDF Viewer Content -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Preview Actions Bar -->
        <Border Grid.Row="0" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource SurfaceBrush}" Padding="15,0">
            <Grid>
                <!-- Title Left -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="M19 8H5c-1.66 0-3 1.34-3 3v6h4v4h12v-4h4v-6c0-1.66-1.34-3-3-3zm-3 11H8v-5h8v5zm3-7c-.55 0-1-.45-1-1s.45-1 1-1 1 .45 1 1-.45 1-1 1zm-1-9H6v4h12V3z" 
                          Fill="{DynamicResource AccentBrush}" 
                          Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="Tax Invoice Print Preview" Style="{StaticResource Header2}" FontSize="14" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Actions Right -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- Print Direct -->
                    <Button Content="Quick Print" Click="Print_Click" Margin="0,0,8,0" Padding="15,0" Height="32"/>
                    <!-- Open Externally -->
                    <Button Content="Open in System PDF" Style="{StaticResource SecondaryButton}" Click="OpenExternal_Click" Margin="0,0,8,0" Padding="15,0" Height="32"/>
                    <!-- Close -->
                    <Button Content="Close" Style="{StaticResource SecondaryButton}" Click="Close_Click" Padding="15,0" Height="32"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- PDF Render WebBrowser -->
        <Border Grid.Row="1" Margin="10" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}">
            <WebBrowser x:Name="pdfBrowser"/>
        </Border>
    </Grid>
</Window>
