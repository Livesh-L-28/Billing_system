<UserControl x:Class="BillingSoftware.UI.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BillingSoftware.UI.Views"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="900">
     <Grid>
         <Grid.RowDefinitions>
             <!-- Filter Toolbar Card -->
             <RowDefinition Height="Auto" />
             <!-- Reports TabControl -->
             <RowDefinition Height="*" />
         </Grid.RowDefinitions>

         <!-- FILTER BAR CARD -->
         <Border Grid.Row="0" Style="{StaticResource ModernCard}" Margin="0,0,0,15">
             <Grid>
                 <Grid.ColumnDefinitions>
                     <ColumnDefinition Width="Auto" />
                     <ColumnDefinition Width="200" />
                     <ColumnDefinition Width="Auto" />
                     <ColumnDefinition Width="200" />
                     <ColumnDefinition Width="*" />
                 </Grid.ColumnDefinitions>

                 <TextBlock Grid.Column="0" Text="Start Date:" Style="{StaticResource BodyText}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                 <DatePicker Grid.Column="1" SelectedDate="{Binding StartDate}" Height="36" VerticalAlignment="Center"/>

                 <TextBlock Grid.Column="2" Text="End Date:" Style="{StaticResource BodyText}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="20,0,10,0"/>
                 <DatePicker Grid.Column="3" SelectedDate="{Binding EndDate}" Height="36" VerticalAlignment="Center"/>

                 <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                     <Button Content="Generate GST Report" Command="{Binding GenerateReportCommand}" Margin="0,0,8,0" Height="36" Padding="15,0"/>
                     <Button Content="Export Excel Bundle" Command="{Binding ExportExcelCommand}" Style="{StaticResource SecondaryButton}" Height="36" Padding="15,0"/>
                 </StackPanel>
             </Grid>
         </Border>

         <!-- REPORTS TAB CONTENT -->
         <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0" Padding="0,10,0,0">
             
             <!-- Tab 1: GSTR-1 B2B -->
             <TabItem Header="GSTR-1 B2B (Registered)" FontSize="13" FontWeight="SemiBold" Padding="15,6">
                 <Grid Margin="0,10,0,0">
                     <DataGrid ItemsSource="{Binding B2BSales}" IsReadOnly="True">
                         <DataGrid.Columns>
                             <DataGridTextColumn Header="Invoice Date" Binding="{Binding InvoiceDate, StringFormat={}{0:dd-MMM-yyyy}}" Width="*" />
                             <DataGridTextColumn Header="Invoice No" Binding="{Binding InvoiceNo}" Width="1.2*" />
                             <DataGridTextColumn Header="Customer Name" Binding="{Binding CustomerName}" Width="2*" />
                             <DataGridTextColumn Header="Customer GSTIN" Binding="{Binding CustomerGSTIN}" Width="1.3*" />
                             <DataGridTextColumn Header="Place of Supply" Binding="{Binding PlaceOfSupply}" Width="*" />
                             <DataGridTextColumn Header="Taxable Value (₹)" Binding="{Binding TaxableValue, StringFormat={}{0:N2}}" Width="*" />
                             <DataGridTextColumn Header="CGST (₹)" Binding="{Binding CGST, StringFormat={}{0:N2}}" Width="0.8*" />
                             <DataGridTextColumn Header="SGST (₹)" Binding="{Binding SGST, StringFormat={}{0:N2}}" Width="0.8*" />
                             <DataGridTextColumn Header="IGST (₹)" Binding="{Binding IGST, StringFormat={}{0:N2}}" Width="0.8*" />
                             <DataGridTextColumn Header="Grand Total (₹)" Binding="{Binding InvoiceValue, StringFormat={}{0:N2}}" Width="1.2*" />
                         </DataGrid.Columns>
                     </DataGrid>
                 </Grid>
             </TabItem>

             <!-- Tab 2: GSTR-1 B2C -->
             <TabItem Header="GSTR-1 B2C (POS Sales)" FontSize="13" FontWeight="SemiBold" Padding="15,6">
                 <Grid Margin="0,10,0,0">
                     <DataGrid ItemsSource="{Binding B2CSales}" IsReadOnly="True">
                         <DataGrid.Columns>
                             <DataGridTextColumn Header="Place of Supply (POS State)" Binding="{Binding PlaceOfSupply}" Width="2*" />
                             <DataGridTextColumn Header="Taxable Value (₹)" Binding="{Binding TaxableValue, StringFormat={}{0:N2}}" Width="*" />
                             <DataGridTextColumn Header="CGST (₹)" Binding="{Binding CGST, StringFormat={}{0:N2}}" Width="*" />
                             <DataGridTextColumn Header="SGST (₹)" Binding="{Binding SGST, StringFormat={}{0:N2}}" Width="*" />
                             <DataGridTextColumn Header="IGST (₹)" Binding="{Binding IGST, StringFormat={}{0:N2}}" Width="*" />
                             <DataGridTextColumn Header="Total Sales Value (₹)" Binding="{Binding InvoiceValue, StringFormat={}{0:N2}}" Width="1.5*" />
                         </DataGrid.Columns>
                     </DataGrid>
                 </Grid>
             </TabItem>

             <!-- Tab 3: GSTR-1 HSN Summary -->
             <TabItem Header="GSTR-1 HSN Summary" FontSize="13" FontWeight="SemiBold" Padding="15,6">
                 <Grid Margin="0,10,0,0">
                     <DataGrid ItemsSource="{Binding HsnSummary}" IsReadOnly="True">
                         <DataGrid.Columns>
                             <DataGridTextColumn Header="HSN" Binding="{Binding HSNCode}" Width="0.8*" />
                             <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="2*" />
                             <DataGridTextColumn Header="UQC (Unit)" Binding="{Binding UQC}" Width="0.8*" />
                             <DataGridTextColumn Header="Total Qty" Binding="{Binding TotalQuantity}" Width="0.8*" />
                             <DataGridTextColumn Header="Total Value" Binding="{Binding TotalValue, StringFormat={}{0:N2}}" Width="*" />
                             <DataGridTextColumn Header="Taxable Value" Binding="{Binding TaxableValue, StringFormat={}{0:N2}}" Width="*" />
                             <DataGridTextColumn Header="GST %" Binding="{Binding GSTPercentage, StringFormat={}{0}%}" Width="0.6*" />
                             <DataGridTextColumn Header="CGST (₹)" Binding="{Binding CGST, StringFormat={}{0:N2}}" Width="0.8*" />
                             <DataGridTextColumn Header="SGST (₹)" Binding="{Binding SGST, StringFormat={}{0:N2}}" Width="0.8*" />
                             <DataGridTextColumn Header="IGST (₹)" Binding="{Binding IGST, StringFormat={}{0:N2}}" Width="0.8*" />
                             <DataGridTextColumn Header="Net Amount" Binding="{Binding TotalAmount, StringFormat={}{0:N2}}" Width="1.2*" />
                         </DataGrid.Columns>
                     </DataGrid>
                 </Grid>
             </TabItem>

             <!-- Tab 4: GSTR-2 Purchases -->
             <TabItem Header="GSTR-2 Purchases" FontSize="13" FontWeight="SemiBold" Padding="15,6">
                 <Grid Margin="0,10,0,0">
                     <DataGrid ItemsSource="{Binding Purchases}" IsReadOnly="True">
                         <DataGrid.Columns>
                             <DataGridTextColumn Header="Purchase Date" Binding="{Binding PurchaseDate, StringFormat={}{0:dd-MMM-yyyy}}" Width="*" />
                             <DataGridTextColumn Header="Supplier Invoice No" Binding="{Binding InvoiceNo}" Width="1.2*" />
                             <DataGridTextColumn Header="Supplier Name" Binding="{Binding SupplierName}" Width="2*" />
                             <DataGridTextColumn Header="Supplier GSTIN" Binding="{Binding SupplierGSTIN}" Width="1.3*" />
                             <DataGridTextColumn Header="Taxable Value (₹)" Binding="{Binding TaxableValue, StringFormat={}{0:N2}}" Width="*" />
                             <DataGridTextColumn Header="CGST (₹)" Binding="{Binding CGST, StringFormat={}{0:N2}}" Width="0.8*" />
                             <DataGridTextColumn Header="SGST (₹)" Binding="{Binding SGST, StringFormat={}{0:N2}}" Width="0.8*" />
                             <DataGridTextColumn Header="IGST (₹)" Binding="{Binding IGST, StringFormat={}{0:N2}}" Width="0.8*" />
                             <DataGridTextColumn Header="Total Purchase (₹)" Binding="{Binding InvoiceValue, StringFormat={}{0:N2}}" Width="1.2*" />
                         </DataGrid.Columns>
                     </DataGrid>
                 </Grid>
             </TabItem>
         </TabControl>
     </Grid>
</UserControl>
