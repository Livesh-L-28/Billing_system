<UserControl x:Class="BillingSoftware.UI.Views.BillingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BillingSoftware.UI.Views"
             mc:Ignorable="d" 
             d:DesignHeight="650" d:DesignWidth="1050"
             PreviewKeyDown="UserControl_PreviewKeyDown">
    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Left Side: Invoicing Line Entries -->
            <ColumnDefinition Width="2.2*" />
            <!-- Right Side: Totals & Meta Options -->
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- LEFT SIDE: LINE ITEMS BUILDER -->
        <Grid Grid.Column="0" Margin="0,0,15,0">
            <Grid.RowDefinitions>
                <!-- Customer Details Card -->
                <RowDefinition Height="Auto" />
                <!-- Item Entry Bar -->
                <RowDefinition Height="Auto" />
                <!-- Items Added DataGrid -->
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 1. Customer Selection Card -->
            <Border Grid.Row="0" Style="{StaticResource ModernCard}" Margin="0,0,0,15">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                        <Border Width="4" Height="18" Background="{DynamicResource AccentGradientBrush}" CornerRadius="2" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Customer Billing Information" Style="{StaticResource Header2}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Customer Selector -->
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="Select Customer *" Style="{StaticResource MutedText}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding CustomersView}" 
                                      SelectedItem="{Binding SelectedCustomer}" 
                                      DisplayMemberPath="Name"
                                      IsEditable="True"
                                      IsTextSearchEnabled="False"
                                      KeyUp="CustomerComboBox_KeyUp" />
                        </StackPanel>

                        <!-- Billing Address (Read-only) -->
                        <StackPanel Grid.Column="1" Margin="10,0,10,0">
                            <TextBlock Text="Billing Address" Style="{StaticResource MutedText}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding BillingAddress, Mode=OneWay}" IsReadOnly="True" />
                        </StackPanel>

                        <!-- Shipping Address (Editable) -->
                        <StackPanel Grid.Column="2" Margin="10,0,0,0">
                            <TextBlock Text="Shipping Address" Style="{StaticResource MutedText}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding ShippingAddress, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- 2. Line Item Entry Builder Bar -->
            <Border Grid.Row="1" Style="{StaticResource ModernCard}" Margin="0,0,0,15">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                        <Border Width="4" Height="18" Background="{DynamicResource AccentGradientBrush}" CornerRadius="2" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Add Product Line Item" Style="{StaticResource Header2}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2.2*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Product Selector -->
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="Select Product *" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding ProductsView}" 
                                      SelectedItem="{Binding SelectedProduct}" 
                                      DisplayMemberPath="Name"
                                      IsEditable="True"
                                      IsTextSearchEnabled="False"
                                      KeyUp="ProductComboBox_KeyUp" />
                        </StackPanel>

                        <!-- Quantity -->
                        <StackPanel Grid.Column="1" Margin="8,0,8,0">
                            <TextBlock Text="Qty" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding LineQuantity, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <!-- Rate -->
                        <StackPanel Grid.Column="2" Margin="8,0,8,0">
                            <TextBlock Text="Rate (₹)" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding LineRate, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <!-- Discount % -->
                        <StackPanel Grid.Column="3" Margin="8,0,8,0">
                            <TextBlock Text="Disc (%)" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding LineDiscountPercent, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <!-- Sub Total -->
                        <StackPanel Grid.Column="4" Margin="8,0,8,0" VerticalAlignment="Center">
                            <TextBlock Text="Line Total (₹)" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding LineTotal, StringFormat={}{0:N2}}" Style="{StaticResource BodyText}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Add Item Button -->
                        <Button Grid.Column="5" Content="Add Item" 
                                Command="{Binding AddItemCommand}" 
                                VerticalAlignment="Bottom" Height="36" Padding="12,0"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- 3. Added Line Items Grid -->
            <DataGrid Grid.Row="2" ItemsSource="{Binding InvoiceItems}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Product / Item Description" Binding="{Binding ProductName}" Width="2*" />
                    <DataGridTextColumn Header="HSN" Binding="{Binding HSNCode}" Width="0.8*" />
                    <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="0.6*" />
                    <DataGridTextColumn Header="Rate" Binding="{Binding Rate, StringFormat={}{0:N2}}" Width="0.8*" />
                    <DataGridTextColumn Header="Disc %" Binding="{Binding DiscountPercent}" Width="0.6*" />
                    <DataGridTextColumn Header="Taxable Value (₹)" Binding="{Binding TaxableValue, StringFormat={}{0:N2}}" Width="*" />
                    <DataGridTextColumn Header="GST %" Binding="{Binding GSTPercentage, StringFormat={}{0}%}" Width="0.6*" />
                    <!-- CGST -->
                    <DataGridTextColumn Header="CGST (₹)" Binding="{Binding CGSTAmount, StringFormat={}{0:N2}}" Width="0.8*" />
                    <!-- SGST -->
                    <DataGridTextColumn Header="SGST (₹)" Binding="{Binding SGSTAmount, StringFormat={}{0:N2}}" Width="0.8*" />
                    <!-- IGST -->
                    <DataGridTextColumn Header="IGST (₹)" Binding="{Binding IGSTAmount, StringFormat={}{0:N2}}" Width="0.8*" />
                    <!-- Total Amount -->
                    <DataGridTextColumn Header="Net Amount" Binding="{Binding TotalAmount, StringFormat={}{0:N2}}" Width="*" />
                    
                    <!-- Action Column -->
                    <DataGridTemplateColumn Header="Action" Width="Auto">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Remove" 
                                        Style="{StaticResource DangerButton}" 
                                        Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                        CommandParameter="{Binding}" 
                                        Height="24" Padding="6,0" FontSize="11" Margin="2"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- RIGHT SIDE: TOTALS & SUMMARY -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <!-- Invoice Settings Meta -->
                <RowDefinition Height="Auto" />
                <!-- Grand Totals Display Card -->
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 1. Invoice Meta Details Card -->
            <Border Grid.Row="0" Style="{StaticResource ModernCard}" Margin="0,0,0,15">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                        <Border Width="4" Height="18" Background="{DynamicResource AccentGradientBrush}" CornerRadius="2" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Invoice Meta Parameters" Style="{StaticResource Header2}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1">
                        <!-- Invoice Number Options -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                <TextBlock Text="Invoice Number" Style="{StaticResource MutedText}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding FormattedInvoiceNumber, UpdateSourceTrigger=PropertyChanged}" 
                                         IsEnabled="{Binding IsManualInvoiceNumber}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="0,0,0,6">
                                <CheckBox Content="Manual" 
                                          IsChecked="{Binding IsManualInvoiceNumber}"
                                          IsEnabled="{Binding IsNewMode}" />
                            </StackPanel>
                        </Grid>

                        <!-- Invoice Date -->
                        <TextBlock Text="Invoice Date" Style="{StaticResource MutedText}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <DatePicker SelectedDate="{Binding InvoiceDate}" Margin="0,0,0,10"/>

                        <!-- Payment Method -->
                        <TextBlock Text="Payment Mode" Style="{StaticResource MutedText}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding PaymentMethods}" SelectedItem="{Binding PaymentMethod}" Margin="0,0,0,10"/>

                        <!-- Due Date -->
                        <TextBlock Text="Due Date" Style="{StaticResource MutedText}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <DatePicker SelectedDate="{Binding DueDate}" Margin="0,0,0,12"/>

                        <!-- PO details -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            
                            <!-- PO Number -->
                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                <TextBlock Text="PO Number" Style="{StaticResource MutedText}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding POInvoiceNumber, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <!-- PO Date -->
                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                <TextBlock Text="PO Date" Style="{StaticResource MutedText}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <DatePicker SelectedDate="{Binding PODate}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. Invoice Grand Totals Summary Card -->
            <Border Grid.Row="1" Style="{StaticResource ModernCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                        <Border Width="4" Height="18" Background="{DynamicResource AccentGradientBrush}" CornerRadius="2" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Taxation &amp; Summary" Style="{StaticResource Header2}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Scrollable summary entries -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,5,0">
                        <StackPanel>
                            
                            <!-- Taxable Value Subtotal -->
                            <Grid Margin="0,2">
                                <TextBlock Text="Taxable Subtotal:" Style="{StaticResource BodyText}" />
                                <TextBlock Text="{Binding SubTotal, StringFormat=₹{0:N2}}" Style="{StaticResource BodyText}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                            </Grid>

                            <!-- Line Discount -->
                            <Grid Margin="0,2">
                                <TextBlock Text="Total Discount (-) :" Style="{StaticResource BodyText}" />
                                <TextBlock Text="{Binding DiscountTotal, StringFormat=₹{0:N2}}" Style="{StaticResource BodyText}" Foreground="{DynamicResource DangerBrush}" HorizontalAlignment="Right" />
                            </Grid>
                            
                            <Separator Background="{DynamicResource BorderBrush}" Margin="0,5"/>

                            <!-- CGST -->
                            <Grid Margin="0,2">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CGSTTotal}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <TextBlock Text="CGST (Central Tax):" Style="{StaticResource BodyText}" Foreground="{DynamicResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding CGSTTotal, StringFormat=₹{0:N2}}" Style="{StaticResource BodyText}" HorizontalAlignment="Right" />
                            </Grid>

                            <!-- SGST -->
                            <Grid Margin="0,2">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SGSTTotal}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <TextBlock Text="SGST (State Tax):" Style="{StaticResource BodyText}" Foreground="{DynamicResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding SGSTTotal, StringFormat=₹{0:N2}}" Style="{StaticResource BodyText}" HorizontalAlignment="Right" />
                            </Grid>

                            <!-- IGST -->
                            <Grid Margin="0,2">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IGSTTotal}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <TextBlock Text="IGST (Integrated Tax):" Style="{StaticResource BodyText}" Foreground="{DynamicResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding IGSTTotal, StringFormat=₹{0:N2}}" Style="{StaticResource BodyText}" HorizontalAlignment="Right" />
                            </Grid>

                            <Separator Background="{DynamicResource BorderBrush}" Margin="0,5"/>

                            <!-- Round Off -->
                            <Grid Margin="0,2">
                                <TextBlock Text="Rounding Adjustment:" Style="{StaticResource BodyText}" Foreground="{DynamicResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding RoundOff, StringFormat=₹{0:N2}}" Style="{StaticResource BodyText}" HorizontalAlignment="Right" />
                            </Grid>

                            <!-- Grand Total -->
                            <Border Background="{DynamicResource BackgroundBrush}" CornerRadius="6" Padding="12" Margin="0,10">
                                <Grid>
                                    <TextBlock Text="Grand Total (₹):" Style="{StaticResource BodyText}" FontWeight="Bold" FontSize="16" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding GrandTotal, StringFormat=₹{0:N2}}" Style="{StaticResource BodyText}" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" FontSize="18" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Amount in Words -->
                            <TextBlock Text="Amount in Words:" Style="{StaticResource MutedText}" FontWeight="Bold" Margin="0,5,0,0"/>
                            <TextBlock Text="{Binding AmountInWords}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,10" Height="40" FontStyle="Italic"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Save, Print & Clear Action Buttons -->
                    <StackPanel Grid.Row="2" Margin="0,15,0,0">
                        <Button Content="Print Invoice" Command="{Binding PrintInvoiceCommand}" Height="40" Margin="0,0,0,8"/>
                        <Button Content="Save Invoice" Command="{Binding SaveInvoiceCommand}" Style="{StaticResource SecondaryButton}" Height="40" Margin="0,0,0,8"/>
                        <Button Content="Clear Form" Command="{Binding ClearFormCommand}" Style="{StaticResource SecondaryButton}" Height="36"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
