<UserControl x:Class="BillingSoftware.UI.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BillingSoftware.UI.Views"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="900">
    <Grid>
        <Grid.RowDefinitions>
            <!-- KPI Summary Header Row -->
            <RowDefinition Height="Auto" />
            <!-- Main Content Area Grid -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- TOP ROW: KPI SUMMARY CARDS -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Card 1: Today Sales Count -->
            <Border Grid.Column="0" Style="{StaticResource ModernCard}" Margin="0,0,8,0" Background="{DynamicResource KPINumber1Brush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="TODAY'S INVOICES" Style="{StaticResource MutedText}" FontSize="10" FontWeight="Bold"/>
                        <TextBlock Text="{Binding TodaySalesCount}" Style="{StaticResource Header1}" FontSize="24" Margin="0,5,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1" Width="40" Height="40" CornerRadius="20" Background="{DynamicResource AccentLightBrush}" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <Path Data="M14 2H6C4.9 2 4.01 2.9 4.01 4L4 20C4 21.1 4.89 22 5.99 22H18C19.1 22 20 21.1 20 20V8L14 2M18 20H6V4H13V9H18V20Z" 
                               Fill="{DynamicResource AccentBrush}" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Card 2: Today Sales Amount -->
            <Border Grid.Column="1" Style="{StaticResource ModernCard}" Margin="8,0,8,0" Background="{DynamicResource KPINumber2Brush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="TODAY'S REVENUE" Style="{StaticResource MutedText}" FontSize="10" FontWeight="Bold"/>
                        <TextBlock Text="{Binding TodaySalesTotal, StringFormat=₹{0:N0}}" Style="{StaticResource Header1}" FontSize="24" Foreground="{DynamicResource AccentBrush}" Margin="0,5,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1" Width="40" Height="40" CornerRadius="20" Background="{DynamicResource SuccessLightBrush}" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <Path Data="M21 18V19C21 20.1 20.1 21 19 21H5C3.9 21 3 20.1 3 19V5C3 3.9 3.9 3 5 3H19C20.1 3 21 3.9 21 5V6H12C10.9 6 10 6.9 10 8V16C10 17.1 10.9 18 12 18H21M12 16H22V8H12V16M16 13C15.4 13 15 12.6 15 12S15.4 11 16 11 17 11.4 17 12 16.6 13 16 13Z" 
                               Fill="{DynamicResource SuccessBrush}" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Card 3: Today GST Collected -->
            <Border Grid.Column="2" Style="{StaticResource ModernCard}" Margin="8,0,8,0" Background="{DynamicResource KPINumber3Brush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="GST COLLECTED" Style="{StaticResource MutedText}" FontSize="10" FontWeight="Bold"/>
                        <TextBlock Text="{Binding TodayGSTCollected, StringFormat=₹{0:N0}}" Style="{StaticResource Header1}" FontSize="24" Foreground="{DynamicResource SuccessBrush}" Margin="0,5,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1" Width="40" Height="40" CornerRadius="20" Background="{DynamicResource WarningLightBrush}" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <Path Data="M19 3H5C3.89 3 3 3.89 3 5V19C3 20.1 3.89 21 5 21H19C20.1 21 21 20.1 21 19V5C21 3.89 20.1 3 19 3M19 19H5V5H19V19M7 10H9V17H7V10M11 13H13V17H11V13M15 7H17V17H15V7Z" 
                               Fill="{DynamicResource WarningBrush}" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Card 4: Total Customers -->
            <Border Grid.Column="3" Style="{StaticResource ModernCard}" Margin="8,0,8,0" Background="{DynamicResource KPINumber4Brush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="ACTIVE CUSTOMERS" Style="{StaticResource MutedText}" FontSize="10" FontWeight="Bold"/>
                        <TextBlock Text="{Binding TotalCustomers}" Style="{StaticResource Header1}" FontSize="24" Margin="0,5,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1" Width="40" Height="40" CornerRadius="20" Background="{DynamicResource AccentLightBrush}" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <Path Data="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5s-3 1.34-3 3 1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5 5 1.34 5 3s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z" 
                               Fill="{DynamicResource AccentBrush}" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Card 5: Total Products -->
            <Border Grid.Column="4" Style="{StaticResource ModernCard}" Margin="8,0,0,0" Background="{DynamicResource KPINumber5Brush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="PRODUCTS REGISTERED" Style="{StaticResource MutedText}" FontSize="10" FontWeight="Bold"/>
                        <TextBlock Text="{Binding TotalProducts}" Style="{StaticResource Header1}" FontSize="24" Margin="0,5,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1" Width="40" Height="40" CornerRadius="20" Background="{DynamicResource SuccessLightBrush}" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <Path Data="M17,17H7V15H17V17M17,13H7V11H17V13M17,9H7V7H17V9M19,3H5C3.89,3 3,3.89 3,5V19C3,20.1 3.89,21 5,21H19C20.1,21 21,20.1 21,19V5C21,3.89 20.1,3 19,3M19,19H5V5H19V19Z" 
                              Fill="{DynamicResource SuccessBrush}" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- BOTTOM ROW: WORKSPACE TABLES -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="2.5*" />
            </Grid.ColumnDefinitions>

            <!-- Low Stock Warnings Grid Card -->
            <Border Grid.Column="0" Style="{StaticResource ModernCard}" Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="4" Height="18" Background="{DynamicResource AccentGradientBrush}" CornerRadius="2" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Low Stock Warnings (Reorder Alerts)" Style="{StaticResource Header2}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Path Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z" 
                              Fill="{DynamicResource DangerBrush}" 
                              Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding LowStockProducts}" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Product Name" Binding="{Binding Name}" Width="2*" />
                            <DataGridTextColumn Header="Category" Binding="{Binding Category.Name}" Width="*" />
                            <DataGridTextColumn Header="Current Stock" Binding="{Binding CurrentStock}" Width="*" />
                            <DataGridTextColumn Header="Reorder Level" Binding="{Binding MinimumStockLevel}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Recent System Activity Logs Card -->
            <Border Grid.Column="1" Style="{StaticResource ModernCard}" Margin="10,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                        <Border Width="4" Height="18" Background="{DynamicResource AccentGradientBrush}" CornerRadius="2" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Recent System Activity Trails" Style="{StaticResource Header2}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding RecentLogs}" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Timestamp" Binding="{Binding Timestamp, StringFormat={}{0:HH:mm:ss}}" Width="*" />
                            <DataGridTextColumn Header="Module" Binding="{Binding Module}" Width="*" />
                            <DataGridTextColumn Header="Details" Binding="{Binding Details}" Width="2*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
