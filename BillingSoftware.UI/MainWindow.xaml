<Window x:Class="BillingSoftware.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BillingSoftware.UI"
        xmlns:viewmodels="clr-namespace:BillingSoftware.UI.ViewModels"
        xmlns:views="clr-namespace:BillingSoftware.UI.Views"
        mc:Ignorable="d"
        Title="TexVibe GST Billing Software" 
        Height="700" Width="1100"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" 
                      ResizeBorderThickness="6" 
                      CornerRadius="0" 
                      GlassFrameThickness="1" 
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    
    <Window.Resources>
        <!-- MVVM Dynamic Page Mapping -->
        <DataTemplate DataType="{x:Type viewmodels:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:CustomerListViewModel}">
            <views:CustomerListView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:ProductListViewModel}">
            <views:ProductListView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:SupplierListViewModel}">
            <views:SupplierListView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:BillingViewModel}">
            <views:BillingView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:ReportsViewModel}">
            <views:ReportsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:BackupViewModel}">
            <views:BackupView />
        </DataTemplate>
    </Window.Resources>

    <Border CornerRadius="16" 
            Background="{DynamicResource BackgroundBrush}" 
            BorderBrush="{DynamicResource GlassBorderBrush}" 
            BorderThickness="1.5"
            ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="25" Color="#000000" Opacity="0.15" ShadowDepth="4" Direction="270" />
        </Border.Effect>
        
        <Grid>
            <Grid.RowDefinitions>
                <!-- Row 0: Custom Title Bar -->
                <RowDefinition Height="40" />
                <!-- Row 1: Content Area -->
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- TITLE BAR PANEL -->
            <Border Grid.Row="0" 
                    Background="{DynamicResource SurfaceBrush}" 
                    BorderBrush="{DynamicResource BorderBrush}" 
                    BorderThickness="0,0,0,1"
                    CornerRadius="14,14,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <!-- Left: Logo & Branding -->
                        <ColumnDefinition Width="Auto" />
                        <!-- Middle: Spacer/Drag -->
                        <ColumnDefinition Width="*" />
                        <!-- Right: Actions -->
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="15,0">
                        <Path Data="M12,3L1,9L12,15L21,10.09V17H23V9L12,3M18.82,12.5L12,16.25L5.18,12.5L3,13.68L12,18.68L21,13.68L18.82,12.5Z" 
                              Fill="{DynamicResource AccentBrush}" 
                              Stretch="Uniform" Width="18" Height="18" 
                              VerticalAlignment="Center" />
                        <TextBlock Text="TexVibe GST Billing" 
                                   Foreground="{DynamicResource TextBrush}" 
                                   FontSize="13" FontWeight="Bold" 
                                   VerticalAlignment="Center" Margin="8,0,0,0"
                                   FontFamily="{StaticResource MainFont}"/>
                    </StackPanel>

                    <!-- System Controls -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" WindowChrome.IsHitTestVisibleInChrome="True" Margin="0,0,5,0">
                        <Button Style="{StaticResource WindowMinButton}" Click="MinimizeButton_Click" ToolTip="Minimize"/>
                        <Button Style="{StaticResource WindowMaxButton}" Click="MaximizeButton_Click" ToolTip="Maximize/Restore"/>
                        <Button Style="{StaticResource WindowCloseButton}" Click="CloseButton_Click" ToolTip="Close"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- MAIN LAYOUT -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <!-- Column 0: Collapsible Sidebar -->
                    <ColumnDefinition Width="Auto" />
                    <!-- Column 1: Main Panel -->
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- LEFT SIDEBAR (FLOATING) -->
                <Border Grid.Column="0" 
                        Background="{DynamicResource SidebarGradientBrush}" 
                        BorderBrush="{DynamicResource GlassBorderBrush}" 
                        BorderThickness="1.5"
                        Margin="12,12,0,12"
                        CornerRadius="12">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Width" Value="240" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSidebarExpanded}" Value="False">
                                    <Setter Property="Width" Value="70" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    
                    <Grid>
                        <Grid.RowDefinitions>
                            <!-- Brand Section -->
                            <RowDefinition Height="60" />
                            <!-- Navigation Options -->
                            <RowDefinition Height="*" />
                            <!-- Bottom Logout Area -->
                            <RowDefinition Height="60" />
                        </Grid.RowDefinitions>

                        <!-- Brand / Logo Header -->
                        <Grid Grid.Row="0" Margin="15,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="35" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            
                            <!-- Simple Logo Icon -->
                            <Path Data="M12,3L1,9L12,15L21,10.09V17H23V9L12,3M18.82,12.5L12,16.25L5.18,12.5L3,13.68L12,18.68L21,13.68L18.82,12.5Z" 
                                  Fill="{DynamicResource AccentBrush}" 
                                  Stretch="Uniform" Width="24" Height="24" 
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                            
                            <!-- Title (Hidden when collapsed) -->
                            <TextBlock Grid.Column="1" Text="TEXVIBE" 
                                       Foreground="{DynamicResource TextBrush}" 
                                       FontSize="18" FontWeight="Bold" 
                                       VerticalAlignment="Center" Margin="10,0,0,0"
                                       FontFamily="{StaticResource MainFont}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSidebarExpanded}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <!-- Navigation List -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False">
                            <StackPanel Margin="0,15">
                                
                                <!-- Dashboard Button -->
                                <RadioButton Style="{StaticResource SidebarButton}" 
                                             Command="{Binding ShowDashboardCommand}" 
                                             IsChecked="True"
                                             Tag="M19,5V19H5V5H19M19,3H5A2,2 0 0,0 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5A2,2 0 0,0 19,3M11,7H7V11H11V7M17,7H13V13H17V7M11,13H7V17H11V13M17,15H13V17H17V15Z"
                                             Content="Dashboard" />

                                <!-- Billing Button -->
                                <RadioButton Style="{StaticResource SidebarButton}" 
                                             Command="{Binding ShowBillingCommand}"
                                             Tag="M19,3H5C3.89,3 3,3.9 3,5V19C3,20.1 3.89,21 5,21H19C20.1,21 21,20.1 21,19V5C21,3.9 20.1,3 19,3M19,19H5V5H19V19M7,10H17V8H7V10M7,14H17V12H7V14M7,16H14V15H7V16Z"
                                             Content="New Bill / Invoice" />

                                <!-- Customers Button -->
                                <RadioButton Style="{StaticResource SidebarButton}" 
                                             Command="{Binding ShowCustomersCommand}"
                                             Tag="M12,4A4,4 0 0,1 16,8A4,4 0 0,1 12,12A4,4 0 0,1 8,8A4,4 0 0,1 12,4M12,14C16.42,14 20,15.79 20,18V20H4V18C4,15.79 7.58,14 12,14Z"
                                             Content="Customers Master" />

                                <!-- Products Button -->
                                <RadioButton Style="{StaticResource SidebarButton}" 
                                             Command="{Binding ShowProductsCommand}"
                                             Tag="M4,6H20V8H4V6M5,19V10H19V19A2,2 0 0,1 17,21H7A2,2 0 0,1 5,19M11,12V15H13V12H11Z"
                                             Content="Products Registry" />

                                <!-- Suppliers Button -->
                                <RadioButton Style="{StaticResource SidebarButton}" 
                                             Command="{Binding ShowSuppliersCommand}"
                                             Tag="M20 18C20 19.1 19.1 20 18 20S16 19.1 16 18H8C8 19.1 7.1 20 6 20S4 19.1 4 18H3V11L7 5H15V13H19L21 15.4V18H20M6 18C6.6 18 7 17.6 7 17S6.6 16 6 16 5 16.4 5 17 5.4 18 6 18M18 18C18.6 18 19 17.6 19 17S18.6 16 18 16 17 16.4 17 17 17.4 18 18 18M13 7H9V11H13V7M17 14.8L15.8 13.3V13H15V15H17.2L17 14.8Z"
                                             Content="Suppliers Master" />

                                <!-- Reports Button -->
                                <RadioButton Style="{StaticResource SidebarButton}" 
                                             Command="{Binding ShowReportsCommand}"
                                             Tag="M16,11.78L20.22,7.56L21.64,8.97L16,14.61L12,10.61L7.17,15.44L5.75,14.03L12,7.78L16,11.78Z"
                                             Content="GST &amp; Audit Reports" />

                                <!-- Backup Button -->
                                <RadioButton Style="{StaticResource SidebarButton}" 
                                             Command="{Binding ShowBackupCommand}"
                                             Tag="M19.35 10.04C18.67 6.59 15.64 4 12 4 9.11 4 6.6 5.64 5.35 8.04 2.34 8.36 0 10.91 0 14c0 3.31 2.69 6 6 6h13c2.76 0 5-2.24 5-5 0-2.64-2.05-4.78-4.65-4.96zM19 18H6c-2.21 0-4-1.79-4-4 0-2.05 1.53-3.76 3.56-3.97l1.07-.11.5-.95C8.08 7.14 9.94 6 12 6c2.62 0 4.88 1.86 5.39 4.43l.3 1.5 1.53.11c1.56.1 2.78 1.41 2.78 2.96 0 1.65-1.35 3-3 3z"
                                             Content="Backup &amp; Restore" />

                                <!-- Settings Button -->
                                <RadioButton Style="{StaticResource SidebarButton}" 
                                             Command="{Binding ShowSettingsCommand}"
                                             Tag="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.66 15.47,5.34 14.86,5.08L14.47,2.42C14.43,2.18 14.22,2 13.97,2H9.97C9.72,2 9.51,2.18 9.47,2.42L9.08,5.08C8.47,5.34 7.9,5.66 7.38,6.05L4.89,5.05C4.67,4.96 4.4,5.05 4.28,5.27L2.28,8.73C2.16,8.95 2.21,9.22 2.4,9.37L4.51,11C4.47,11.34 4.5,11.67 4.5,12C4.5,12.33 4.47,12.65 4.51,13L2.4,14.63C2.21,14.78 2.16,15.05 2.28,15.27L4.28,18.73C4.4,18.95 4.67,19.04 4.89,18.95L7.38,17.95C7.9,18.34 8.47,18.66 9.08,18.92L9.47,21.58C9.51,21.82 9.72,22 9.97,22H13.97C14.22,22 14.43,21.82 14.47,21.58L14.86,18.92C15.47,18.66 16.04,18.34 16.56,17.95L19.05,18.95C19.27,19.04 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.97Z"
                                             Content="System Settings" />

                            </StackPanel>
                        </ScrollViewer>

                        <!-- Footer Logout Button (Floating style) -->
                        <Button Grid.Row="2" Style="{StaticResource SecondaryButton}" 
                                Command="{Binding LogoutCommand}" 
                                BorderThickness="0" Height="44" Margin="10,8" Padding="12,0,0,0"
                                HorizontalContentAlignment="Left">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Path Data="M14.08,15.59L16.67,13H7V11H16.67L14.08,8.41L15.5,7L20.5,12L15.5,17L14.08,15.59M9,5A2,2 0 0,0 7,3H4A2,2 0 0,0 2,5V19A2,2 0 0,0 4,21H7A2,2 0 0,0 9,19C9,17.9 8.1,17 7,17H4V5H7C8.1,5 9,4.1 9,3V5Z" 
                                      Fill="{DynamicResource DangerBrush}" 
                                      Stretch="Uniform" Width="18" Height="18" Grid.Column="0" VerticalAlignment="Center"/>
                                <TextBlock Text="Sign Out" Foreground="{DynamicResource DangerBrush}" 
                                           FontWeight="SemiBold" Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"
                                           FontFamily="{StaticResource MainFont}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSidebarExpanded}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Button>
                    </Grid>
                </Border>

                <!-- RIGHT WORKSPACE PANEL (FLOATING DESIGN) -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <!-- Header Top Bar -->
                        <RowDefinition Height="Auto" />
                        <!-- Workspace Page Content -->
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- HEADER / TOP BAR (FLOATING CARD) -->
                    <Border Grid.Row="0" 
                            Background="{DynamicResource SurfaceBrush}" 
                            BorderBrush="{DynamicResource GlassBorderBrush}" 
                            BorderThickness="1.5" 
                            Margin="12,12,12,0"
                            CornerRadius="12"
                            Padding="15,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <!-- Collapse Sidebar Toggle Button -->
                                <ColumnDefinition Width="Auto" />
                                <!-- Page Title Header -->
                                <ColumnDefinition Width="*" />
                                <!-- User Status Area -->
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Toggle Sidebar Button -->
                            <Button Grid.Column="0" Style="{StaticResource SecondaryButton}" 
                                    Command="{Binding ToggleSidebarCommand}" 
                                    Width="36" Height="36" Padding="0">
                                <!-- Hamburger Icon Path -->
                                <Path Data="M3,6H21V8H3V6M3,11H21V13H3V11M3,16H21V18H3V16Z" 
                                      Fill="{DynamicResource TextBrush}" 
                                      Stretch="Uniform" Width="18" Height="18"/>
                            </Button>

                            <!-- Active Page Title -->
                            <TextBlock Grid.Column="1" Text="{Binding CurrentViewModel.Title}" 
                                       Style="{StaticResource Header2}" 
                                       VerticalAlignment="Center" Margin="15,0,0,0"/>

                            <!-- User Shift & Financial Year Context -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- User info -->
                                <Border Background="{DynamicResource BackgroundBrush}" 
                                        CornerRadius="15" Padding="12,6" Margin="0,0,10,0"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                    <StackPanel Orientation="Horizontal">
                                        <!-- User Icon -->
                                        <Path Data="M12,4A4,4 0 0,1 16,8A4,4 0 0,1 12,12A4,4 0 0,1 8,8A4,4 0 0,1 12,4M12,14C16.42,14 20,15.79 20,18V20H4V18C4,15.79 7.58,14 12,14Z" 
                                              Fill="{DynamicResource AccentBrush}" 
                                              Stretch="Uniform" Width="14" Height="14" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding CurrentUserDisplayName}" Style="{StaticResource BodyText}" 
                                                   FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"
                                                   FontFamily="{StaticResource MainFont}"/>
                                        <TextBlock Text=" (" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding CurrentUserRole}" Style="{StaticResource MutedText}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <TextBlock Text=")" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <!-- Financial Year badge -->
                                <Border Background="{DynamicResource AccentGradientBrush}" CornerRadius="15" Padding="14,6">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="M19 19H5V8H19M19 3H18V1H16V3H8V1H6V3H5C3.89 3 3 3.9 3 5V19C3 20.1 3.89 21 5 21H19C20.1 21 21 20.1 21 19V5C21 3.9 20.1 3 19 3Z" 
                                              Fill="White" Stretch="Uniform" Width="12" Height="12" VerticalAlignment="Center"/>
                                        <TextBlock Text="F.Y. " Style="{StaticResource BodyText}" Foreground="White" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding CurrentFinancialYearName}" Style="{StaticResource BodyText}" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- WORKSPACE PAGE VIEW -->
                    <ContentControl Grid.Row="1" Content="{Binding CurrentViewModel}" Margin="12" Focusable="False"/>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
