<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Modern Fluent Dark Color Palette -->
    <Color x:Key="BackgroundColor">#0F172A</Color>
    <Color x:Key="SurfaceColor">#1E293B</Color>
    <Color x:Key="BorderColor">#334155</Color>
    <Color x:Key="BorderHoverColor">#475569</Color>
    <Color x:Key="TextColor">#F8FAFC</Color>
    <Color x:Key="TextMutedColor">#94A3B8</Color>
    
    <Color x:Key="AccentColor">#818CF8</Color>
    <Color x:Key="AccentHoverColor">#6366F1</Color>
    <Color x:Key="AccentLightColor">#1E1B4B</Color>
    
    <Color x:Key="DangerColor">#FB7185</Color>
    <Color x:Key="DangerHoverColor">#F43F5E</Color>
    <Color x:Key="DangerLightColor">#4C0519</Color>
    
    <Color x:Key="SuccessColor">#34D399</Color>
    <Color x:Key="SuccessLightColor">#064E3B</Color>
    
    <Color x:Key="WarningColor">#FBBF24</Color>
    <Color x:Key="WarningLightColor">#78350F</Color>
    
    <Color x:Key="CardBackgroundColor">#1E293B</Color>
    <Color x:Key="SidebarBackgroundColor">#0F172A</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="BorderHoverBrush" Color="{StaticResource BorderHoverColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
    
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentLightBrush" Color="{StaticResource AccentLightColor}" />
    
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="DangerHoverBrush" Color="{StaticResource DangerHoverColor}" />
    <SolidColorBrush x:Key="DangerLightBrush" Color="{StaticResource DangerLightColor}" />
    
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="SuccessLightBrush" Color="{StaticResource SuccessLightColor}" />
    
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="WarningLightBrush" Color="{StaticResource WarningLightColor}" />
    
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource CardBackgroundColor}" />
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="{StaticResource SidebarBackgroundColor}" />

    <!-- Premium Gradients and Modern Visual Brushes -->
    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#818CF8" Offset="0.0" />
        <GradientStop Color="#C084FC" Offset="1.0" />
    </LinearGradientBrush>
    
    <LinearGradientBrush x:Key="AccentHoverGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#6366F1" Offset="0.0" />
        <GradientStop Color="#A855F7" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="SidebarGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#0F172A" Offset="0.0" />
        <GradientStop Color="#090D16" Offset="1.0" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="GlassBorderBrush" Color="#20FFFFFF" />
    <SolidColorBrush x:Key="CardGlowBrush" Color="#15818CF8" />
    <SolidColorBrush x:Key="WindowGlowBrush" Color="#60000000" />

</ResourceDictionary>
