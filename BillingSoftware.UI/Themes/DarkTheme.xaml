<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Modern Fluent Dark Color Palette (Premium Deep Midnight) -->
    <Color x:Key="BackgroundColor">#090D16</Color>
    <Color x:Key="SurfaceColor">#111827</Color>
    <Color x:Key="BorderColor">#1F2937</Color>
    <Color x:Key="BorderHoverColor">#374151</Color>
    <Color x:Key="TextColor">#F9FAFB</Color>
    <Color x:Key="TextMutedColor">#9CA3AF</Color>
    
    <Color x:Key="AccentColor">#818CF8</Color>
    <Color x:Key="AccentHoverColor">#6366F1</Color>
    <Color x:Key="AccentLightColor">#1E1B4B</Color>
    
    <Color x:Key="DangerColor">#F43F5E</Color>
    <Color x:Key="DangerHoverColor">#E11D48</Color>
    <Color x:Key="DangerLightColor">#4C0519</Color>
    
    <Color x:Key="SuccessColor">#10B981</Color>
    <Color x:Key="SuccessLightColor">#064E3B</Color>
    
    <Color x:Key="WarningColor">#F59E0B</Color>
    <Color x:Key="WarningLightColor">#78350F</Color>
    
    <Color x:Key="CardBackgroundColor">#111827</Color>
    <Color x:Key="SidebarBackgroundColor">#090D16</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="BorderHoverBrush" Color="{StaticResource BorderHoverColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
    
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentLightBrush" Color="{StaticResource AccentLightColor}" />
    
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="DangerHoverBrush" Color="{StaticResource DangerHoverColor}" />
    <SolidColorBrush x:Key="DangerLightBrush" Color="{StaticResource DangerLightColor}" />
    
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="SuccessLightBrush" Color="{StaticResource SuccessLightColor}" />
    
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="WarningLightBrush" Color="{StaticResource WarningLightColor}" />
    
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource CardBackgroundColor}" />
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="{StaticResource SidebarBackgroundColor}" />

    <!-- Premium Gradients and Modern Visual Brushes -->
    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#818CF8" Offset="0.0" />
        <GradientStop Color="#C084FC" Offset="1.0" />
    </LinearGradientBrush>
    
    <LinearGradientBrush x:Key="AccentHoverGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#6366F1" Offset="0.0" />
        <GradientStop Color="#A855F7" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="SidebarGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#090D16" Offset="0.0" />
        <GradientStop Color="#04060B" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Vibrant Dark Gradient Brushes for KPI Cards -->
    <LinearGradientBrush x:Key="KPINumber1Brush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#172554" Offset="0.0" />
        <GradientStop Color="#1E3A8A" Offset="1.0" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="KPINumber2Brush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#064E3B" Offset="0.0" />
        <GradientStop Color="#065F46" Offset="1.0" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="KPINumber3Brush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#7C2D12" Offset="0.0" />
        <GradientStop Color="#78350F" Offset="1.0" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="KPINumber4Brush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#4C1D95" Offset="0.0" />
        <GradientStop Color="#581C87" Offset="1.0" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="KPINumber5Brush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#064E3B" Offset="0.0" />
        <GradientStop Color="#065F46" Offset="1.0" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="GlassBorderBrush" Color="#18FFFFFF" />
    <SolidColorBrush x:Key="CardGlowBrush" Color="#12818CF8" />
    <SolidColorBrush x:Key="WindowGlowBrush" Color="#50000000" />

    <SolidColorBrush x:Key="DataGridHeaderBackgroundBrush" Color="#1E293B" />
    <SolidColorBrush x:Key="DataGridAlternatingRowBrush" Color="#0F172A" />
    <SolidColorBrush x:Key="DataGridRowHoverBrush" Color="#1F2937" />
    <SolidColorBrush x:Key="DataGridRowSelectedBrush" Color="#312E81" />

</ResourceDictionary>
