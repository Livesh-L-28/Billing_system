<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Modern Fluent Light Color Palette -->
    <Color x:Key="BackgroundColor">#F8FAFC</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="BorderColor">#E2E8F0</Color>
    <Color x:Key="BorderHoverColor">#CBD5E1</Color>
    <Color x:Key="TextColor">#0F172A</Color>
    <Color x:Key="TextMutedColor">#64748B</Color>
    
    <Color x:Key="AccentColor">#6366F1</Color>
    <Color x:Key="AccentHoverColor">#4F46E5</Color>
    <Color x:Key="AccentLightColor">#EEF2FF</Color>
    
    <Color x:Key="DangerColor">#F43F5E</Color>
    <Color x:Key="DangerHoverColor">#E11D48</Color>
    <Color x:Key="DangerLightColor">#FFF1F2</Color>
    
    <Color x:Key="SuccessColor">#10B981</Color>
    <Color x:Key="SuccessLightColor">#E6FBF4</Color>
    
    <Color x:Key="WarningColor">#F59E0B</Color>
    <Color x:Key="WarningLightColor">#FFFBEB</Color>
    
    <Color x:Key="CardBackgroundColor">#FFFFFF</Color>
    <Color x:Key="SidebarBackgroundColor">#FFFFFF</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="BorderHoverBrush" Color="{StaticResource BorderHoverColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
    
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentLightBrush" Color="{StaticResource AccentLightColor}" />
    
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="DangerHoverBrush" Color="{StaticResource DangerHoverColor}" />
    <SolidColorBrush x:Key="DangerLightBrush" Color="{StaticResource DangerLightColor}" />
    
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="SuccessLightBrush" Color="{StaticResource SuccessLightColor}" />
    
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="WarningLightBrush" Color="{StaticResource WarningLightColor}" />
    
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource CardBackgroundColor}" />
    <!-- High-Contrast Dark Sidebar in Light Mode -->
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#0F172A" />

    <!-- Premium Gradients and Modern Visual Brushes -->
    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#6366F1" Offset="0.0" />
        <GradientStop Color="#8B5CF6" Offset="1.0" />
    </LinearGradientBrush>
    
    <LinearGradientBrush x:Key="AccentHoverGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#4F46E5" Offset="0.0" />
        <GradientStop Color="#7C3AED" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="SidebarGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#0F172A" Offset="0.0" />
        <GradientStop Color="#1E1B4B" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Vibrant Soft Gradient Brushes for KPI Cards -->
    <LinearGradientBrush x:Key="KPINumber1Brush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#EFF6FF" Offset="0.0" />
        <GradientStop Color="#DBEAFE" Offset="1.0" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="KPINumber2Brush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#ECFDF5" Offset="0.0" />
        <GradientStop Color="#D1FAE5" Offset="1.0" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="KPINumber3Brush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFF7ED" Offset="0.0" />
        <GradientStop Color="#FFEDD5" Offset="1.0" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="KPINumber4Brush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F5F3FF" Offset="0.0" />
        <GradientStop Color="#EDE9FE" Offset="1.0" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="KPINumber5Brush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#ECFDF5" Offset="0.0" />
        <GradientStop Color="#D1FAE5" Offset="1.0" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="GlassBorderBrush" Color="#120F172A" />
    <SolidColorBrush x:Key="CardGlowBrush" Color="#106366F1" />
    <SolidColorBrush x:Key="WindowGlowBrush" Color="#15000000" />
    
    <SolidColorBrush x:Key="DataGridHeaderBackgroundBrush" Color="#F1F5F9" />
    <SolidColorBrush x:Key="DataGridAlternatingRowBrush" Color="#F8FAFC" />
    <SolidColorBrush x:Key="DataGridRowHoverBrush" Color="#F1F5F9" />
    <SolidColorBrush x:Key="DataGridRowSelectedBrush" Color="#EEF2FF" />

</ResourceDictionary>
